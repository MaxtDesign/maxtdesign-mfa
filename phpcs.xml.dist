<?xml version="1.0"?>
<ruleset name="MaxtDesign MFA">
	<description>WordPress Coding Standards for MaxtDesign MFA.</description>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<file>maxtdesign-mfa.php</file>
	<file>uninstall.php</file>
	<file>src</file>
	<file>tools</file>
	<file>templates</file>
	<file>languages</file>

	<config name="minimum_wp_version" value="7.0"/>

	<rule ref="WordPress-Extra">
		<!-- PSR-4 class files under src/ (MaxtDesign\Mfa); file names follow the class. -->
		<exclude name="WordPress.Files.FileName"/>
	</rule>
	<rule ref="WordPress-Docs"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="maxtdesign-mfa"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="mdmfa"/>
				<element value="MaxtDesign\Mfa"/>
			</property>
		</properties>
	</rule>
</ruleset>
